{
  "name": "@alilc/lowcode-datasource-engine",
  "version": "1.2.1",
  "description": "DataSource Engine for lowcode",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./interpret": {
      "types": "./dist/interpret/index.d.ts",
      "import": "./dist/interpret/index.mjs",
      "require": "./dist/interpret/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "test": "ava",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@alilc/lowcode-datasource-types": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "lodash": "^4.17.21",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@ava/babel": "^2.0.0",
    "@types/lodash": "^4.17.26",
    "@types/sinon": "^22.0.0",
    "ava": "^8.1.0",
    "get-port": "^7.2.0",
    "json5": "^2.2.3",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
