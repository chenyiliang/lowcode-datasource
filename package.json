{
  "name": "ali-lowcode-datasource",
  "version": "1.2.1",
  "private": true,
  "description": "LowCode DataSource Engine & Handlers (React 19 + Vite)",
  "repository": "git@github.com:alibaba/lowcode-datasource.git",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "clean": "pnpm --filter \"./packages/*\" --parallel clean",
    "typecheck": "pnpm --filter \"./packages/*\" --parallel typecheck",
    "test": "pnpm --filter \"./packages/*\" --parallel test",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx ./ --quiet",
    "lint:fix": "eslint --ext .ts,.tsx,.js,.jsx ./ --quiet --fix"
  },
  "devDependencies": {
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
